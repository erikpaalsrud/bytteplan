# Use the HTTPS origin of the Docker-hosted app, without trailing slash.
PUBLIC_ORIGIN=https://bytteplan.example.no
SITE_DOMAIN=bytteplan.example.no
VAPID_SUBJECT=mailto:coach@example.no
# Generate these once with npm run keys. Keep the same keys across deployments.
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
